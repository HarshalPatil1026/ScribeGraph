# Copy this file to .env and fill in what you need.  NEVER commit your .env file.
# Nested settings use a double underscore (llm__api_key, r2__bucket_name, ...).

# ── LLM (required for real runs) ─────────────────────────────────────────────
# Free key: https://console.groq.com/keys   (GROQ_API_KEY also works)
llm__api_key=""
# Any Groq chat model. llama-3.3-70b-versatile was retired for free accounts in Aug 2026.
llm__model_name="openai/gpt-oss-120b"

# ── Storage ──────────────────────────────────────────────────────────────────
# auto  = Cloudflare R2 if all r2__* values are set, otherwise local
# local = write into scribegraph/web/blogs (commit it; GitHub Pages serves it)
# r2    = Cloudflare R2 bucket (the site reads it via R2_PUBLIC_URL in js/config.js)
storage__backend="auto"

r2__account_id=""
r2__access_key_id=""
r2__secret_access_key=""
r2__bucket_name=""

# ── AI News research (needed for --ainews; one of the two is enough) ─────────
content__tavily_api_key=""
content__guardian_api_key=""

# ── Pipeline tuning (optional) ───────────────────────────────────────────────
# pipeline__max_revisions=3
# pipeline__history_size=5

# ── Observability (optional) ─────────────────────────────────────────────────
# Opik prompt library + tracing: also run `uv sync --extra opik`
OPIK_API_KEY=""
OPIK_PROJECT_NAME="scribegraph"
# OPIK_WORKSPACE=""

SENTRY_DSN=""
